# ================================
# 🔐 SECURITY & SESSION
# ================================
SESSION_SECRET=super_strong_secret_key_change_this_in_production_12345!
JWT_SECRET=your_jwt_secret_key_here_for_api_auth_67890!

# ================================
# 🐬 DATABASE CONFIGURATION
# ================================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=wapi
DB_PORT=3306
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0

# ================================
# 🌐 SERVER CONFIGURATION
# ================================
SERVER_PORT=3001
SERVER_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# ================================
# ⏰ CRON & RATE LIMITING
# ================================
DAILY_MESSAGE_LIMIT_BASIC=250
DAILY_MESSAGE_LIMIT_STANDARD=500
DAILY_MESSAGE_LIMIT_PRO=1000

# ================================
# 📧 NOTIFICATION & SUPPORT
# ================================
SUPPORT_EMAIL=support@jasaedukasi.com
PRICING_URL=https://wapi.jasaedukasi.com/#pricing
APP_NAME=WhatsApp Gateway W@Pi

# ================================
# 🕒 TIMEZONE
# ================================
TZ="+07:00"

# ================================
# 🚫 OPTIONAL - DISABLED FEATURES
# ================================
# DISABLE_CRON=false
# MAINTENANCE_MODE=false
FEATURE_OPT_IN=0
CRON_OPERATIONAL_24H=true
AUTO_OPT_IN_INVITATION=false