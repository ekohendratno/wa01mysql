<div class="d-flex justify-content-between align-items-center mb-4">
  <h4 class="text-success">
    <i class="fa fa-inbox me-2"></i>Inbox
  </h4>
  <div class="input-group" style="max-width: 360px">
    <span class="input-group-text"><i class="fa fa-search"></i></span>
    <input id="inboxSearch" class="form-control" placeholder="Cari pengirim atau isi pesan" onkeyup="loadInbox(1)" />
  </div>
</div>

<div class="stat-card">
  <div class="d-flex justify-content-end mb-3">
    <button class="btn btn-outline-danger btn-sm" onclick="clearInbox()">
      <i class="fa fa-trash-can me-1"></i> Hapus Semua
    </button>
  </div>
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead>
        <tr>
          <th>Waktu</th>
          <th>Pengirim</th>
          <th>Pesan</th>
          <th>Device</th>
          <th>Tipe</th>
          <th>Aksi</th>
        </tr>
      </thead>
      <tbody id="inboxBody">
        <tr>
          <td colspan="6" class="text-center py-4">Memuat inbox...</td>
        </tr>
      </tbody>
    </table>
  </div>
  <nav class="mt-3">
    <ul id="inboxPagination" class="pagination justify-content-center"></ul>
  </nav>
</div>

<script>
  function formatDate(value) {
    if (!value) return "-";
    return new Date(value).toLocaleString("id-ID", {
      day: "2-digit",
      month: "short",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    });
  }

  async function loadInbox(page = 1) {
    const search = encodeURIComponent(document.getElementById("inboxSearch").value || "");
    const response = await fetch(`/client/inbox/data?page=${page}&limit=30&search=${search}`);
    const result = await response.json();
    const body = document.getElementById("inboxBody");

    if (!result.status || !result.messages || result.messages.length === 0) {
      body.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-muted">Belum ada pesan masuk.</td></tr>';
      document.getElementById("inboxPagination").innerHTML = "";
      return;
    }

    body.innerHTML = result.messages.map((message) => {
      const number = (message.remote_jid || "").split("@")[0];
      const safeName = escapeHtml(message.push_name || "Tanpa Nama");
      const safeRemoteJid = escapeHtml(message.remote_jid || "-");
      const safeMessage = escapeHtml(message.message || "");
      const safeDeviceKey = escapeHtml(message.device_key || "-");
      return `
        <tr>
          <td><small>${formatDate(message.received_at)}</small></td>
          <td>
            <strong>${safeName}</strong><br />
            <small class="text-muted">${safeRemoteJid}</small>
          </td>
          <td style="max-width: 420px"><div class="text-truncate">${safeMessage}</div></td>
          <td><span class="badge bg-light text-dark border">${safeDeviceKey}</span></td>
          <td>${message.is_group ? '<span class="badge bg-info">Group</span>' : '<span class="badge bg-success">Personal</span>'}</td>
          <td>
            <a class="btn btn-sm btn-outline-success" href="/client/message?to=${encodeURIComponent(number)}">
              <i class="fa fa-reply"></i>
            </a>
            <button class="btn btn-sm btn-outline-danger ms-1" onclick="removeInboxMessage(${message.id})">
              <i class="fa fa-trash"></i>
            </button>
          </td>
        </tr>
      `;
    }).join("");

    renderInboxPagination(result.pagination);
  }

  function renderInboxPagination(pagination) {
    const container = document.getElementById("inboxPagination");
    container.innerHTML = "";
    if (!pagination || pagination.totalPages <= 1) return;

    for (let page = 1; page <= pagination.totalPages; page++) {
      container.innerHTML += `
        <li class="page-item ${page === pagination.page ? "active" : ""}">
          <a class="page-link" href="javascript:void(0)" onclick="loadInbox(${page})">${page}</a>
        </li>
      `;
    }
  }

  async function removeInboxMessage(id) {
    if (!confirm("Hapus pesan inbox ini?")) return;

    try {
      const response = await fetch(`/client/inbox/remove/${encodeURIComponent(id)}`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
      });
      const result = await response.json();

      if (!result.status) {
        showToast(result.message || "Gagal menghapus pesan inbox.", "danger");
        return;
      }

      showToast("Pesan inbox berhasil dihapus.", "success");
      loadInbox(1);
    } catch (error) {
      console.error(error);
      showToast("Terjadi kesalahan saat menghapus inbox.", "danger");
    }
  }

  async function clearInbox() {
    if (!confirm("Hapus semua data inbox akun ini? Data yang dihapus tidak bisa dikembalikan.")) return;

    try {
      const response = await fetch("/client/inbox/clear", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
      });
      const result = await response.json();

      if (!result.status) {
        showToast(result.message || "Gagal menghapus semua inbox.", "danger");
        return;
      }

      showToast(result.message || "Semua inbox berhasil dihapus.", "success");
      document.getElementById("inboxSearch").value = "";
      loadInbox(1);
    } catch (error) {
      console.error(error);
      showToast("Terjadi kesalahan saat menghapus semua inbox.", "danger");
    }
  }

  document.addEventListener("DOMContentLoaded", () => loadInbox(1));
</script>
