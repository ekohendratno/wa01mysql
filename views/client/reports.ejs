<div class="d-flex justify-content-between align-items-center mb-4">
  <h4 class="text-success">
    <i class="fa fa-chart-line me-2"></i>Reports
  </h4>
</div>

<div class="row">
  <div class="col-lg-8">
    <div class="stat-card">
      <h5 class="mb-4">Pengiriman 30 Hari Terakhir</h5>
      <div class="chart-container">
        <canvas id="dailyChart"></canvas>
      </div>
    </div>
  </div>
  <div class="col-lg-4">
    <div class="stat-card">
      <h5 class="mb-3">Performa Device</h5>
      <div class="table-responsive">
        <table class="table table-sm align-middle">
          <thead>
            <tr>
              <th>Device</th>
              <th>Total</th>
              <th>Sent</th>
              <th>Failed</th>
            </tr>
          </thead>
          <tbody>
            <% if (!devices || devices.length === 0) { %>
            <tr><td colspan="4" class="text-muted text-center">Belum ada data.</td></tr>
            <% } else { %>
              <% devices.forEach((device) => { %>
              <tr>
                <td><%= device.name || device.device_key %></td>
                <td><%= device.total || 0 %></td>
                <td><span class="text-success"><%= device.sent || 0 %></span></td>
                <td><span class="text-danger"><%= device.failed || 0 %></span></td>
              </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<div class="stat-card">
  <h5 class="mb-3">Campaign Terbaru</h5>
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead>
        <tr>
          <th>Campaign</th>
          <th>Penerima</th>
          <th>Sent</th>
          <th>Pending</th>
          <th>Failed</th>
          <th>Dibuat</th>
        </tr>
      </thead>
      <tbody>
        <% if (!campaigns || campaigns.length === 0) { %>
        <tr><td colspan="6" class="text-center text-muted py-4">Belum ada campaign.</td></tr>
        <% } else { %>
          <% campaigns.forEach((campaign) => { %>
          <tr>
            <td><%= campaign.name %></td>
            <td><%= campaign.recipients_count %></td>
            <td><span class="badge bg-success"><%= campaign.sent || 0 %></span></td>
            <td><span class="badge bg-secondary"><%= campaign.pending || 0 %></span></td>
            <td><span class="badge bg-danger"><%= campaign.failed || 0 %></span></td>
            <td><small class="text-muted"><%= moment(campaign.created_at).format("DD MMM YYYY, HH:mm") %></small></td>
          </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<script>
  const dailyData = <%- JSON.stringify(daily || []) %>;
  const labels = dailyData.map((item) => new Date(item.date).toLocaleDateString("id-ID", { day: "2-digit", month: "short" }));

  new Chart(document.getElementById("dailyChart"), {
    type: "line",
    data: {
      labels,
      datasets: [
        { label: "Sent", data: dailyData.map((item) => item.sent || 0), borderColor: "#198754", backgroundColor: "rgba(25, 135, 84, .08)", fill: true },
        { label: "Pending", data: dailyData.map((item) => item.pending || 0), borderColor: "#6c757d", backgroundColor: "rgba(108, 117, 125, .08)", fill: true },
        { label: "Processing", data: dailyData.map((item) => item.processing || 0), borderColor: "#ffc107", backgroundColor: "rgba(255, 193, 7, .08)", fill: true },
        { label: "Failed", data: dailyData.map((item) => item.failed || 0), borderColor: "#dc3545", backgroundColor: "rgba(220, 53, 69, .08)", fill: true },
      ],
    },
    options: { responsive: true, maintainAspectRatio: false },
  });
</script>
