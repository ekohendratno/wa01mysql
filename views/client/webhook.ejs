<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1 text-primary"><i class="fas fa-gears me-2"></i>Manajemen Webhook</h4>
        <p class="text-muted mb-0">Konfigurasi URL callback untuk menerima notifikasi pesan masuk secara real-time.</p>
    </div>
    <a href="/client/webhook/logs" class="btn btn-outline-primary">
        <i class="fa fa-clock-rotate-left me-1"></i> Logs
    </a>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <% if (devices && devices.length > 0) { %>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="bg-light">
                                <tr>
                                    <th class="py-3 ps-3 rounded-start">Device Name</th>
                                    <th class="py-3">Nomor WhatsApp</th>
                                    <th class="py-3">Webhook URL</th>
                                    <th class="py-3 text-end pe-3 rounded-end">Aksi</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% devices.forEach(device => { %>
                                <tr id="row-<%= device.device_key %>">
                                    <td class="ps-3 fw-medium">
                                        <%= device.name || 'Tanpa Nama' %>
                                        <br>
                                        <small class="text-muted"><%= device.device_key %></small>
                                    </td>
                                    <td>
                                        <% if (device.phone) { %>
                                            <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill">
                                                <i class="fab fa-whatsapp me-1"></i> <%= device.phone %>
                                            </span>
                                        <% } else { %>
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary px-3 py-2 rounded-pill">
                                                Not Connected
                                            </span>
                                        <% } %>
                                    </td>
                                    <td style="width: 40%;">
                                        <div class="input-group">
                                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="fas fa-link"></i></span>
                                            <input type="url" 
                                                   class="form-control border-start-0 ps-0" 
                                                   id="webhook-<%= device.device_key %>" 
                                                   value="<%= device.webhook_url || '' %>"
                                                   placeholder="https://your-domain.com/webhook"
                                                   readonly>
                                        </div>
                                    </td>
                                    <td class="text-end pe-3">
                                        <button class="btn btn-outline-primary btn-sm rounded-3 px-3 edit-btn" 
                                                data-key="<%= device.device_key %>"
                                                onclick="enableEdit('<%= device.device_key %>')">
                                            <i class="fas fa-pen me-1"></i> Edit
                                        </button>
                                        <button class="btn btn-primary btn-sm rounded-3 px-3 d-none save-btn" 
                                                id="save-<%= device.device_key %>"
                                                onclick="saveWebhook('<%= device.device_key %>')">
                                            <i class="fas fa-save me-1"></i> Simpan
                                        </button>
                                        <button class="btn btn-light btn-sm rounded-3 px-3 d-none cancel-btn" 
                                                id="cancel-<%= device.device_key %>"
                                                onclick="cancelEdit('<%= device.device_key %>')">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </td>
                                </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="text-center py-5">
                        <img src="https://cdni.iconscout.com/illustration/premium/thumb/empty-state-2130362-1800926.png" alt="Empty" style="max-width: 200px; opacity: 0.8;">
                        <h5 class="mt-3 text-muted">Belum ada perangkat terhubung</h5>
                        <p class="text-muted small">Silakan tambahkan perangkat terlebih dahulu di menu Device.</p>
                        <a href="/client/device" class="btn btn-primary px-4 rounded-pill mt-2">Tambah Device</a>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
    
    <div class="col-md-12 mt-4">
        <div class="card border-0 shadow-sm rounded-4 bg-info bg-opacity-10">
            <div class="card-body p-4">
                <div class="d-flex">
                    <div class="flex-shrink-0">
                        <i class="fas fa-info-circle fa-2x text-info"></i>
                    </div>
                    <div class="flex-grow-1 ms-3">
                        <h5 class="text-info fw-bold mb-2">Informasi Payload Webhook</h5>
                        <p class="text-muted mb-2 small">Ketika pesan masuk diterima, kami akan mengirimkan data JSON berikut ke URL Webhook Anda:</p>
                        <pre class="bg-dark text-white p-3 rounded-3 small mb-0" style="max-height: 200px; overflow-y: auto;">
{
  "event": "messages.upsert",
  "device_key": "device_123...",
  "remoteJid": "62812345678@s.whatsapp.net",
  "pushName": "John Doe",
  "message": "Halo, ini pesan test",
  "timestamp": 1678888888,
  "fromMe": false,
  "isGroup": false
}</pre>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function enableEdit(deviceKey) {
        const input = document.getElementById(`webhook-${deviceKey}`);
        const editBtn = document.querySelector(`#row-${deviceKey} .edit-btn`);
        const saveBtn = document.getElementById(`save-${deviceKey}`);
        const cancelBtn = document.getElementById(`cancel-${deviceKey}`);
        
        // Store original value for cancel
        input.dataset.original = input.value;
        
        input.removeAttribute('readonly');
        input.focus();
        input.classList.add('bg-white', 'border-primary'); // Highlight
        input.classList.remove('bg-light'); // Highlight
        
        editBtn.classList.add('d-none');
        saveBtn.classList.remove('d-none');
        cancelBtn.classList.remove('d-none');
    }

    function cancelEdit(deviceKey) {
        const input = document.getElementById(`webhook-${deviceKey}`);
        const editBtn = document.querySelector(`#row-${deviceKey} .edit-btn`);
        const saveBtn = document.getElementById(`save-${deviceKey}`);
        const cancelBtn = document.getElementById(`cancel-${deviceKey}`);
        
        input.value = input.dataset.original || '';
        input.setAttribute('readonly', true);
        input.classList.remove('bg-white', 'border-primary');
        input.classList.add('bg-light');
        
        editBtn.classList.remove('d-none');
        saveBtn.classList.add('d-none');
        cancelBtn.classList.add('d-none');
    }

    async function saveWebhook(deviceKey) {
        const input = document.getElementById(`webhook-${deviceKey}`);
        const saveBtn = document.getElementById(`save-${deviceKey}`);
        const newUrl = input.value;
        
        // Simple validation
        if (newUrl && !newUrl.startsWith('http')) {
            showToast('URL harus diawali dengan http:// atau https://', 'danger');
            return;
        }

        saveBtn.disabled = true;
        saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

        try {
            const response = await fetch('/client/webhook/update', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ deviceKey, webhookUrl: newUrl })
            });
            
            const result = await response.json();
            
            if (result.status) {
                showToast(result.message, 'success');
                // Reset UI
                input.setAttribute('readonly', true);
                input.classList.remove('bg-white', 'border-primary');
                input.classList.add('bg-light');
                input.dataset.original = newUrl; // Update original
                
                document.querySelector(`#row-${deviceKey} .edit-btn`).classList.remove('d-none');
                document.getElementById(`save-${deviceKey}`).classList.add('d-none');
                document.getElementById(`cancel-${deviceKey}`).classList.add('d-none');
            } else {
                showToast(result.message || 'Gagal menyimpan URL', 'danger');
            }
        } catch (error) {
            console.error(error);
            showToast('Terjadi kesalahan koneksi', 'danger');
        } finally {
            saveBtn.disabled = false;
            saveBtn.innerHTML = '<i class="fas fa-save me-1"></i> Simpan';
        }
    }
</script>
