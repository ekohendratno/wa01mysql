<%
  const visiblePackages = (packages || []).filter(function(pkg) {
    return Number(pkg.active) !== 0;
  });
  const paidPackages = visiblePackages.filter(function(pkg) {
    return Number(pkg.price || 0) > 0;
  });
  const highlightPackage = paidPackages[0] || visiblePackages[0] || null;
  const formatPrice = function(value) {
    return new Intl.NumberFormat('id-ID').format(Number(value || 0));
  };
%>

