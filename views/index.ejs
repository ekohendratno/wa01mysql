<style>
  /* Hero Section */
  .hero-section {
    background-color: var(--bg-hero);
    color: white;
    padding: 100px 0 80px;
    position: relative;
    overflow: hidden;
  }
  .hero-section::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(
      circle at 50% -20%,
      #0d5546 0%,
      transparent 60%
    );
    opacity: 0.6;
  }
  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 800px;
    margin: 0 auto;
  }
  .badge-rating {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 8px 20px;
    border-radius: 50px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.85rem;
    margin-bottom: 32px;
    color: #fff;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    animation: fadeInUp 0.8s ease-out;
  }
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes float {
    0% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
    100% { transform: translateY(0px); }
  }
  .floating-icon {
    animation: float 3s ease-in-out infinite;
  }

  /* How it Works */
  .step-card {
    border: 1px solid #eee;
    border-radius: 12px;
    padding: 24px;
    transition: 0.3s;
    margin-bottom: 24px;
    background: #fff;
  }
  .step-card:hover {
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    border-color: transparent;
    transform: translateY(-5px);
  }
  .step-icon {
    width: 50px;
    height: 50px;
    background: #f0fdf4;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--wa-brand);
    font-size: 1.5rem;
    margin-bottom: 16px;
  }

  /* Cut Costs Section */
  .cut-costs-section {
    background-color: var(--bg-hero);
    color: white;
    padding: 100px 0;
    position: relative;
  }
  .comparison-card {
    background: white;
    border-radius: 16px;
    padding: 30px;
    color: var(--text-dark);
  }
  .price-value {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--wa-brand);
  }

  /* Integrations */
  .integration-icon {
    font-size: 2.5rem;
    color: #ccc;
    transition: 0.3s;
  }
  .integration-icon:hover {
    color: var(--wa-brand);
    transform: scale(1.1);
  }

  /* Testimonials */
  .review-card {
    background: #fff;
    border: 1px solid #eee;
    padding: 24px;
    border-radius: 12px;
    height: 100%;
  }
  .stars {
    color: #ffc107;
    font-size: 0.9rem;
    margin-bottom: 12px;
  }

  /* Bottom CTA */
  .bottom-cta {
    background: radial-gradient(circle at center, #1b4d3e 0%, #003126 100%);
    padding: 80px 0;
    color: white;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .bottom-cta::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 100px;
    background: linear-gradient(to top, rgba(37, 211, 102, 0.2), transparent);
  }

  @media (max-width: 768px) {
    .display-3 {
      font-size: 2.2rem;
      line-height: 1.2;
    }
    .display-4 {
      font-size: 2rem;
    }
    .display-5 {
      font-size: 1.6rem;
    }
    .hero-section {
      padding: 80px 0 60px;
    }
    .hero-btns {
      flex-direction: column;
      width: 100%;
      padding: 0 20px;
    }
    .hero-btns .btn {
      width: 100%;
    }
    .cut-costs-section {
      padding: 60px 0;
    }
    .step-card {
      padding: 16px;
    }
    pre {
      font-size: 0.75rem;
      overflow-x: auto;
    }
  }
</style>

