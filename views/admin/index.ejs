<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h4 class="text-success mb-1"><i class="fa fa-gauge-high me-2"></i>Admin Dashboard</h4>
    <div class="text-muted">Ringkasan operasional platform w@pi</div>
  </div>
  <a href="/admin/system" class="btn btn-outline-success btn-sm">
    <i class="fa fa-heart-pulse me-1"></i> Health
  </a>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-3">
    <div class="stat-card h-100">
      <h5>Saldo User</h5>
      <h2><%= (stats.totalBalance || 0).toLocaleString('id-ID', { style: 'currency', currency: 'IDR' }) %></h2>
      <small class="text-muted">Total saldo tersimpan</small>
    </div>
  </div>
  <div class="col-md-3">
    <div class="stat-card h-100">
      <h5>Users</h5>
      <h2><%= stats.activeUsers || 0 %>/<%= stats.totalUsers || 0 %></h2>
      <small class="text-muted">Aktif / total user</small>
    </div>
  </div>
  <div class="col-md-3">
    <div class="stat-card h-100">
      <h5>Devices</h5>
      <h2><%= stats.activeDevices || 0 %>/<%= stats.totalDevices || 0 %></h2>
      <small class="text-muted">Connected / total device</small>
    </div>
  </div>
  <div class="col-md-3">
    <div class="stat-card h-100">
      <h5>Pesan Bulan Ini</h5>
      <h2><%= stats.messagesThisMonth || 0 %></h2>
      <small class="text-muted"><%= stats.messagesToday || 0 %> pesan hari ini</small>
    </div>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-3">
    <a href="/admin/users" class="text-decoration-none">
      <div class="stat-card h-100 border-start border-4 border-success">
        <h5>User Baru</h5>
        <h2 class="text-success"><%= stats.newUsersToday || 0 %></h2>
        <small class="text-muted"><%= stats.newUsers7d || 0 %> dalam 7 hari</small>
      </div>
    </a>
  </div>
  <div class="col-md-3">
    <a href="/admin/messages?status=pending" class="text-decoration-none">
      <div class="stat-card h-100 border-start border-4 border-warning">
        <h5>Queue Pending</h5>
        <h2 class="text-warning"><%= stats.pendingMessages || 0 %></h2>
        <small class="text-muted">Menunggu cron kirim</small>
      </div>
    </a>
  </div>
  <div class="col-md-3">
    <a href="/admin/messages?status=failed" class="text-decoration-none">
      <div class="stat-card h-100 border-start border-4 border-danger">
        <h5>Pesan Failed</h5>
        <h2 class="text-danger"><%= stats.failedMessages || 0 %></h2>
        <small class="text-muted">Butuh review/retry</small>
      </div>
    </a>
  </div>
  <div class="col-md-3">
    <a href="/admin/billing" class="text-decoration-none">
      <div class="stat-card h-100 border-start border-4 border-info">
        <h5>Billing Pending</h5>
        <h2 class="text-info"><%= stats.pendingTransactions || 0 %></h2>
        <small class="text-muted">Transaksi belum selesai</small>
      </div>
    </a>
  </div>
  <div class="col-md-3">
    <a href="/admin/webhooks?status=failed" class="text-decoration-none">
      <div class="stat-card h-100 border-start border-4 border-danger">
        <h5>Webhook Failed</h5>
        <h2 class="text-danger"><%= stats.webhookFailed24h || 0 %></h2>
        <small class="text-muted">Dalam 24 jam terakhir</small>
      </div>
    </a>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-lg-8">
    <div class="stat-card h-100">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">Statistik Pengiriman</h5>
        <a href="/admin/messages" class="btn btn-sm btn-outline-secondary">Lihat pesan</a>
      </div>
      <div class="chart-container">
        <canvas id="messageChart"></canvas>
      </div>
    </div>
  </div>
  <div class="col-lg-4">
    <div class="stat-card h-100">
      <h5 class="mb-3">Status Pesan</h5>
      <div class="chart-container" style="height: 260px">
        <canvas id="statusChart"></canvas>
      </div>
    </div>
  </div>
</div>

<div class="row g-3">
  <div class="col-lg-6">
    <div class="stat-card h-100">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">Pengguna Baru Terdaftar</h5>
        <a href="/admin/users" class="btn btn-sm btn-outline-secondary">Semua user</a>
      </div>
      <div class="table-responsive">
        <table class="table table-sm align-middle">
          <thead>
            <tr>
              <th>Pengguna</th>
              <th>Status</th>
              <th>Terdaftar</th>
              <th>Online</th>
            </tr>
          </thead>
          <tbody>
            <% if (stats.recentUsers && stats.recentUsers.length) { %>
              <% stats.recentUsers.forEach(function(u) { %>
                <tr>
                  <td>
                    <strong><%= u.name || '-' %></strong><br>
                    <small class="text-muted"><%= u.email || '-' %><%= u.phone ? (' | ' + u.phone) : '' %></small>
                  </td>
                  <td><span class="badge <%= Number(u.active) === 1 ? 'bg-success' : 'bg-secondary' %>"><%= Number(u.active) === 1 ? 'Active' : 'Suspended' %></span></td>
                  <td><small><%= u.created_at ? new Date(u.created_at).toLocaleString('id-ID') : '-' %></small></td>
                  <td><small><%= u.last_active ? new Date(u.last_active).toLocaleString('id-ID') : '-' %></small></td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="4" class="text-muted">Belum ada user.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-lg-6">
    <div class="stat-card h-100">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">Device Terbaru</h5>
        <a href="/admin/devices" class="btn btn-sm btn-outline-secondary">Semua device</a>
      </div>
      <div class="table-responsive">
        <table class="table table-sm align-middle">
          <thead>
            <tr>
              <th>Device</th>
              <th>User</th>
              <th>Status</th>
              <th>Update</th>
            </tr>
          </thead>
          <tbody>
            <% if (stats.recentDevices && stats.recentDevices.length) { %>
              <% stats.recentDevices.forEach(function(d) { %>
                <tr>
                  <td><%= d.name || '-' %><br><small class="text-muted"><%= d.phone || '-' %></small></td>
                  <td><%= d.user_name || '-' %></td>
                  <td><span class="badge <%= d.status === 'connected' ? 'bg-success' : 'bg-secondary' %>"><%= d.status || '-' %></span></td>
                  <td><small><%= d.updated_at ? new Date(d.updated_at).toLocaleString('id-ID') : '-' %></small></td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="4" class="text-muted">Belum ada device.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-lg-6">
    <div class="stat-card h-100">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">Campaign Terbaru</h5>
        <a href="/admin/campaigns" class="btn btn-sm btn-outline-secondary">Semua campaign</a>
      </div>
      <div class="table-responsive">
        <table class="table table-sm align-middle">
          <thead>
            <tr>
              <th>Campaign</th>
              <th>User</th>
              <th>Target</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% if (stats.recentCampaigns && stats.recentCampaigns.length) { %>
              <% stats.recentCampaigns.forEach(function(c) { %>
                <tr>
                  <td><%= c.name %><br><small class="text-muted"><%= c.created_at ? new Date(c.created_at).toLocaleString('id-ID') : '-' %></small></td>
                  <td><%= c.user_name || '-' %></td>
                  <td><%= c.recipients_count || 0 %></td>
                  <td><span class="badge bg-secondary"><%= c.status || '-' %></span></td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="4" class="text-muted">Belum ada campaign.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-12">
    <div class="stat-card">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">Pesan Terakhir</h5>
        <a href="/admin/messages" class="btn btn-sm btn-outline-secondary">Buka queue</a>
      </div>
      <div class="table-responsive">
        <table class="table table-sm align-middle">
          <thead>
            <tr>
              <th>Waktu</th>
              <th>User</th>
              <th>Device</th>
              <th>Nomor</th>
              <th>Pesan</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% if (stats.recentMessages && stats.recentMessages.length) { %>
              <% stats.recentMessages.forEach(function(m) { %>
                <tr>
                  <td><small><%= m.created_at ? new Date(m.created_at).toLocaleString('id-ID') : '-' %></small></td>
                  <td><%= m.user_name || '-' %></td>
                  <td><%= m.device_name || '-' %></td>
                  <td><%= m.number || '-' %></td>
                  <td><%= (m.message || '').length > 90 ? (m.message.substring(0, 90) + '...') : (m.message || '-') %></td>
                  <td><span class="badge bg-secondary"><%= m.status || '-' %></span></td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="6" class="text-muted">Belum ada pesan.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
  function renderLineChart(payload) {
    const canvas = document.getElementById("messageChart");
    if (!canvas || typeof Chart === "undefined") return;
    new Chart(canvas.getContext("2d"), {
      type: "line",
      data: {
        labels: payload.labels || [],
        datasets: [{
          label: "Pesan per hari",
          data: payload.data || [],
          borderColor: "#128c7e",
          backgroundColor: "rgba(18, 140, 126, 0.12)",
          tension: 0.25,
          fill: true,
          pointRadius: 3,
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: { y: { beginAtZero: true } },
        plugins: { legend: { display: false } }
      }
    });
  }

  function renderStatusChart(payload) {
    const canvas = document.getElementById("statusChart");
    if (!canvas || typeof Chart === "undefined") return;
    new Chart(canvas.getContext("2d"), {
      type: "doughnut",
      data: {
        labels: payload.labels || [],
        datasets: [{
          data: payload.data || [],
          backgroundColor: ["#ffc107", "#198754", "#dc3545", "#0dcaf0", "#6c757d"]
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { position: "bottom" } }
      }
    });
  }

  fetch("/admin/api/message-stats?days=14")
    .then((response) => response.json())
    .then(renderLineChart)
    .catch((error) => console.warn("Gagal memuat statistik pesan:", error));

  fetch("/admin/api/status-breakdown")
    .then((response) => response.json())
    .then(renderStatusChart)
    .catch((error) => console.warn("Gagal memuat status pesan:", error));
</script>
