              <% }) %>
            <% } else { %>
              <tr><td colspan="3" class="text-muted">Tidak ada webhook failed terbaru.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
  <div class="col-lg-7">
    <div class="stat-card h-100">
      <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
        <div>
          <h5 class="mb-1">Database Tables</h5>
          <small class="text-muted">Aksi bersih data hanya tersedia untuk tabel log/operasional. Master data dikunci.</small>
        </div>
        <span class="badge bg-warning text-dark">Konfirmasi berlapis</span>
      </div>
      <div class="table-responsive" style="max-height: 420px">
        <table class="table table-sm table-bordered align-middle">
          <thead>
            <tr>
              <th>Table</th>
              <th>Rows</th>
              <th>Data</th>
              <th>Index</th>
              <th>Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% if (health.tables && health.tables.length) { %>
              <% health.tables.forEach(function(t) { %>
                <%
                  const tableName = t.TABLE_NAME || t.table_name;
                  const canPurge = (health.purgeableTables || []).includes(tableName);
                  const isProtected = (health.protectedTables || []).includes(tableName);
                %>
                <tr>
                  <td>
                    <%= tableName %>
                    <% if (isProtected) { %>
                      <span class="badge bg-secondary ms-1">protected</span>
                    <% } else if (canPurge) { %>
                      <span class="badge bg-info text-dark ms-1">cleanup</span>
                    <% } %>
                  </td>
                  <td><%= t.TABLE_ROWS || t.table_rows || 0 %></td>
                  <td><%= Math.round(((t.DATA_LENGTH || t.data_length || 0) / 1024)) %> KB</td>
                  <td><%= Math.round(((t.INDEX_LENGTH || t.index_length || 0) / 1024)) %> KB</td>
                  <td style="min-width: 150px">
                    <% if (canPurge) { %>
                      <button
                        type="button"
                        class="btn btn-sm btn-outline-danger me-1"
                        onclick="openDbPurgeModal('<%= tableName %>', 'delete')"
                      >
                        <i class="fa fa-trash me-1"></i>Hapus
                      </button>
                      <button
                        type="button"
                        class="btn btn-sm btn-danger"
                        onclick="openDbPurgeModal('<%= tableName %>', 'truncate')"
                      >
                        <i class="fa fa-broom me-1"></i>Truncate
                      </button>
                    <% } else { %>
                      <small class="text-muted">Dikunci</small>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr><td colspan="5" class="text-muted">Tidak ada data tabel.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <small class="text-muted d-block mt-2">
        Saran: gunakan <strong>Lebih lama dari 30/90 hari</strong> untuk log. Jangan pakai truncate kecuali benar-benar ingin mengosongkan tabel operasional.
      </small>
    </div>
  </div>
</div>

<div class="modal fade" id="dbPurgeModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <div>
          <h5 class="modal-title mb-1"><i class="fa fa-triangle-exclamation text-danger me-2"></i>Bersihkan Data Tabel</h5>
          <small class="text-muted">Aksi ini permanen. Backup database disarankan sebelum menjalankan.</small>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
      </div>
      <div class="modal-body">
        <div class="alert alert-warning">
          <strong>Peringatan 1:</strong> data yang dihapus tidak bisa dikembalikan dari aplikasi.
          <br>
          <strong>Peringatan 2:</strong> pastikan bukan tabel transaksi, kontak, opt-in, user, device, atau saldo.
        </div>
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label">Tabel</label>
            <input type="text" id="dbPurgeTable" class="form-control" readonly>
          </div>
          <div class="col-md-6">
            <label class="form-label">Aksi</label>
            <select id="dbPurgeAction" class="form-select">
              <option value="delete">Hapus data sesuai scope</option>
              <option value="truncate">Truncate semua data tabel</option>
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label">Scope waktu</label>
            <select id="dbPurgeScope" class="form-select">
              <option value="older30" selected>Lebih lama dari 30 hari</option>
              <option value="older90">Lebih lama dari 90 hari</option>
              <option value="older7">Lebih lama dari 7 hari</option>
              <option value="today">Hari ini</option>
              <option value="yesterday">Kemarin</option>
              <option value="last7">7 hari terakhir</option>
              <option value="all">Semua data</option>
            </select>
            <small class="text-muted">Truncate otomatis memakai scope semua data.</small>
          </div>
          <div class="col-md-6">
            <label class="form-label">Preview terdampak</label>
            <div class="form-control bg-light" id="dbPurgePreview">Klik preview dulu.</div>
          </div>
          <div class="col-12">
            <button type="button" class="btn btn-outline-secondary" id="dbPurgePreviewBtn">
              <i class="fa fa-eye me-1"></i>Preview Jumlah Data
            </button>
          </div>
          <div class="col-12">
            <label class="form-label">Konfirmasi manual</label>
            <input type="text" id="dbPurgeConfirm" class="form-control" placeholder="Ketik kode konfirmasi setelah preview">
            <small class="text-muted" id="dbPurgeConfirmHelp">Kode akan muncul setelah preview.</small>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
        <button type="button" class="btn btn-danger" id="dbPurgeExecuteBtn" disabled>
          <i class="fa fa-trash me-1"></i>Eksekusi
        </button>
      </div>
    </div>
  </div>
</div>
