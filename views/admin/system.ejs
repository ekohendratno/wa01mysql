<script>
  let dbPurgeModalInstance = null;
  let dbPurgeRequiredConfirm = "";
  let dbPurgeLastPreview = null;

  function openDbPurgeModal(tableName, action) {
    const modalEl = document.getElementById("dbPurgeModal");
    dbPurgeModalInstance = bootstrap.Modal.getOrCreateInstance(modalEl);
    dbPurgeRequiredConfirm = "";
    dbPurgeLastPreview = null;

    document.getElementById("dbPurgeTable").value = tableName;
    document.getElementById("dbPurgeAction").value = action || "delete";
    document.getElementById("dbPurgeScope").value = action === "truncate" ? "all" : "older30";
    document.getElementById("dbPurgeScope").disabled = action === "truncate";
    document.getElementById("dbPurgePreview").textContent = "Klik preview dulu.";
    document.getElementById("dbPurgeConfirm").value = "";
    document.getElementById("dbPurgeConfirm").placeholder = "Ketik kode konfirmasi setelah preview";
    document.getElementById("dbPurgeConfirmHelp").textContent = "Kode akan muncul setelah preview.";
    document.getElementById("dbPurgeExecuteBtn").disabled = true;

    dbPurgeModalInstance.show();
  }

  async function previewDbPurge() {
    const table = document.getElementById("dbPurgeTable").value;
    const action = document.getElementById("dbPurgeAction").value;
    const scope = action === "truncate" ? "all" : document.getElementById("dbPurgeScope").value;
    const previewEl = document.getElementById("dbPurgePreview");

    previewEl.textContent = "Menghitung...";
    document.getElementById("dbPurgeExecuteBtn").disabled = true;
    document.getElementById("dbPurgeConfirm").value = "";

    try {
      const params = new URLSearchParams({ table, action, scope });
      const response = await fetch(`/admin/system/database/preview?${params.toString()}`);
      const data = await response.json();
      if (!data.status) throw new Error(data.message || "Preview gagal.");

      dbPurgeLastPreview = data;
      dbPurgeRequiredConfirm = data.confirmText;
      previewEl.textContent = `${data.affectedRows} row akan terdampak (${data.scopeLabel}${data.dateColumn ? `, kolom ${data.dateColumn}` : ""}).`;
      document.getElementById("dbPurgeConfirm").placeholder = data.confirmText;
      document.getElementById("dbPurgeConfirmHelp").innerHTML = `Ketik persis: <code>${data.confirmText}</code>`;
      validateDbPurgeConfirm();
    } catch (error) {
      dbPurgeLastPreview = null;
      dbPurgeRequiredConfirm = "";
      previewEl.textContent = error.message || "Preview gagal.";
      alert(error.message || "Preview gagal.");
    }
  }

  function validateDbPurgeConfirm() {
    const typed = document.getElementById("dbPurgeConfirm").value.trim();
    const executeBtn = document.getElementById("dbPurgeExecuteBtn");
    executeBtn.disabled = !dbPurgeLastPreview || !dbPurgeRequiredConfirm || typed !== dbPurgeRequiredConfirm;
  }

  async function executeDbPurge() {
    if (!dbPurgeLastPreview) {
      alert("Jalankan preview dulu.");
      return;
    }

    const table = document.getElementById("dbPurgeTable").value;
    const action = document.getElementById("dbPurgeAction").value;
    const scope = action === "truncate" ? "all" : document.getElementById("dbPurgeScope").value;
    const confirmText = document.getElementById("dbPurgeConfirm").value.trim();
    const affectedRows = Number(dbPurgeLastPreview.affectedRows || 0);

    const firstWarning = confirm(
      `Anda akan ${action === "truncate" ? "TRUNCATE" : "MENGHAPUS"} data tabel ${table}.\n\nJumlah terdampak: ${affectedRows} row.\nAksi ini permanen. Lanjut?`
    );
    if (!firstWarning) return;

    const secondWarning = confirm(
      `Konfirmasi terakhir.\n\nPastikan backup sudah ada dan tabel ${table} memang boleh dibersihkan.\n\nTetap eksekusi?`
    );
    if (!secondWarning) return;

    const button = document.getElementById("dbPurgeExecuteBtn");
    button.disabled = true;
    button.innerHTML = '<i class="fa fa-spinner fa-spin me-1"></i>Memproses...';

    try {
      const response = await fetch("/admin/system/database/purge", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ table, action, scope, confirmText }),
      });
      const data = await response.json();
      if (!data.status) throw new Error(data.message || "Eksekusi gagal.");

      alert(`${data.message}\nTabel: ${data.table}\nTerhapus: ${data.affectedRows} row`);
      window.location.reload();
    } catch (error) {
      alert(error.message || "Eksekusi gagal.");
      button.disabled = false;
      button.innerHTML = '<i class="fa fa-trash me-1"></i>Eksekusi';
    }
  }

  document.addEventListener("DOMContentLoaded", function () {
    const actionEl = document.getElementById("dbPurgeAction");
    const scopeEl = document.getElementById("dbPurgeScope");
    const confirmEl = document.getElementById("dbPurgeConfirm");
    const previewBtn = document.getElementById("dbPurgePreviewBtn");
    const executeBtn = document.getElementById("dbPurgeExecuteBtn");

    if (actionEl) {
      actionEl.addEventListener("change", function () {
        const isTruncate = actionEl.value === "truncate";
        scopeEl.disabled = isTruncate;
        if (isTruncate) scopeEl.value = "all";
        dbPurgeLastPreview = null;
        dbPurgeRequiredConfirm = "";
        document.getElementById("dbPurgePreview").textContent = "Klik preview dulu.";
        document.getElementById("dbPurgeConfirm").value = "";
        document.getElementById("dbPurgeConfirmHelp").textContent = "Kode akan muncul setelah preview.";
        executeBtn.disabled = true;
      });
    }
    if (scopeEl) {
      scopeEl.addEventListener("change", function () {
        dbPurgeLastPreview = null;
        dbPurgeRequiredConfirm = "";
        document.getElementById("dbPurgePreview").textContent = "Klik preview dulu.";
        document.getElementById("dbPurgeConfirm").value = "";
        executeBtn.disabled = true;
      });
    }
    if (confirmEl) confirmEl.addEventListener("input", validateDbPurgeConfirm);
    if (previewBtn) previewBtn.addEventListener("click", previewDbPurge);
    if (executeBtn) executeBtn.addEventListener("click", executeDbPurge);
  });
</script>

