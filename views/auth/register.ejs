<style>
  :root {
    --wa-brand: #25d366;
    --wa-hover: #1ebc57;
    --wa-dark: #075e54;
    --id-red: #d91f2d;
  }

  .auth-shell {
    min-height: 100vh;
    background: linear-gradient(135deg, #fbfffd, #eefdf4);
  }

  .auth-form-side {
    min-height: 100vh;
    background: rgba(255, 255, 255, 0.92);
  }

  .auth-brand {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--wa-dark);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .auth-brand::after {
    content: "ID";
    font-size: 0.7rem;
    font-weight: 800;
    color: var(--id-red);
    border: 1px solid rgba(217, 31, 45, 0.25);
    border-radius: 999px;
    padding: 2px 7px;
  }

  .form-control-pill {
    border-radius: 8px;
    padding: 13px 15px;
    border: 1px solid #dfe6e3;
    background-color: #f8faf9;
  }

  .form-control-pill:focus {
    border-color: var(--wa-brand);
    box-shadow: 0 0 0 0.2rem rgba(37, 211, 102, 0.2);
    background-color: #fff;
  }

  .btn-brand {
    background-color: var(--wa-brand);
    color: white;
    border: none;
    border-radius: 8px;
    padding: 12px;
    font-weight: 700;
  }

  .btn-brand:hover {
    background-color: var(--wa-hover);
    color: white;
  }

  .auth-visual {
    min-height: 100vh;
    background:
      linear-gradient(135deg, rgba(249, 255, 252, 0.96), rgba(224, 250, 235, 0.92)),
      url("https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&w=1400&q=80");
    background-size: cover;
    background-position: center;
    color: #0b221e;
    position: relative;
    overflow: hidden;
  }

  .indonesia-ribbon {
    display: inline-flex;
    width: 58px;
    height: 12px;
    border-radius: 999px;
    overflow: hidden;
    box-shadow: 0 0 0 1px rgba(7, 94, 84, 0.08);
  }

  .indonesia-ribbon span:first-child {
    background: #e11d2e;
    flex: 1;
  }

  .indonesia-ribbon span:last-child {
    background: #fff;
    flex: 1;
  }

  .benefit-card {
    background: rgba(255, 255, 255, 0.88);
    border: 1px solid #dff1e9;
    border-radius: 8px;
    padding: 18px;
    box-shadow: 0 18px 54px rgba(10, 84, 65, 0.12);
    backdrop-filter: blur(8px);
  }

  .benefit-row {
    display: flex;
    gap: 12px;
    padding: 11px 0;
    border-bottom: 1px solid #e3f2eb;
  }

  .benefit-row:last-child {
    border-bottom: 0;
  }

  .benefit-row i {
    color: var(--wa-brand);
    margin-top: 3px;
  }

  .auth-visual .bg-white.bg-opacity-10 {
    background: rgba(255, 255, 255, 0.86) !important;
    border-color: #dff1e9 !important;
  }

  .auth-visual .text-white-50 {
    color: #5f756f !important;
  }

  @media (max-width: 992px) {
    .auth-form-side {
      min-height: 100vh;
    }
  }
</style>

<div class="container-fluid p-0 auth-shell">
  <div class="row g-0">
    <div class="col-lg-6 auth-form-side d-flex flex-column">
      <div class="d-flex justify-content-between align-items-center p-3 p-md-4">
        <a href="/" class="auth-brand">
          <i class="fab fa-whatsapp text-success" style="font-size: 2rem"></i>
          <span>w@pi</span>
        </a>
        <div class="d-flex gap-2">
          <a href="/" class="btn btn-outline-secondary px-3" style="border-radius: 8px">
            <i class="fas fa-home me-md-2"></i><span class="d-none d-md-inline">Beranda</span>
          </a>
          <a href="/auth/login" class="btn btn-outline-success px-3" style="border-radius: 8px">
            <i class="fas fa-sign-in-alt me-md-2"></i><span class="d-none d-md-inline">Login</span>
          </a>
        </div>
      </div>

      <div class="row justify-content-center my-auto w-100 mx-0 px-4 px-md-5 py-4">
        <div class="col-md-9 col-lg-8">
          <div class="mb-4">
            <div class="d-inline-flex align-items-center gap-2 text-danger fw-bold small mb-3">
              <span class="indonesia-ribbon" aria-hidden="true"><span></span><span></span></span>
              Mulai gratis untuk Indonesia
            </div>
            <h2 class="fw-bold text-dark mb-2">Buat akun w@pi</h2>
            <p class="text-muted mb-0">Hubungkan nomor WhatsApp bisnis, lalu mulai kirim notifikasi, campaign, dan auto reply.</p>
          </div>

          <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
          <% } %>

          <form action="/auth/register" method="POST">
            <div class="mb-3">
              <label class="form-label fw-bold small text-secondary">Nama Lengkap <span class="text-danger">*</span></label>
              <input
                name="name"
                type="text"
                class="form-control form-control-pill"
                placeholder="Contoh: Eko Hendratno"
                value="<%= typeof name !== 'undefined' ? name : '' %>"
                autocomplete="name"
                required
              />
            </div>

            <div class="mb-3">
              <label class="form-label fw-bold small text-secondary">Email <span class="text-danger">*</span></label>
              <input
                name="email"
                type="email"
                class="form-control form-control-pill"
                placeholder="nama@email.com"
                value="<%= typeof email !== 'undefined' ? email : '' %>"
                autocomplete="email"
                required
              />
            </div>

            <div class="mb-3">
              <label class="form-label fw-bold small text-secondary">Nomor WhatsApp <span class="text-danger">*</span></label>
              <div class="input-group">
                <span class="input-group-text bg-light border-end-0" style="border-radius: 8px 0 0 8px; border-color: #dfe6e3">
                  +62
                </span>
                <input
                  name="phone"
                  type="tel"
                  class="form-control form-control-pill border-start-0"
                  style="border-radius: 0 8px 8px 0"
                  placeholder="8123xxxxxxx"
                  value="<%= typeof phone !== 'undefined' ? phone : '' %>"
                  autocomplete="tel"
                  required
                />
              </div>
              <small class="text-muted">Gunakan nomor aktif untuk kebutuhan akun dan notifikasi.</small>
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <label class="form-label fw-bold small text-secondary">Password</label>
                <input
                  name="password"
                  type="password"
                  class="form-control form-control-pill"
                  placeholder="Minimal 6 karakter"
                  minlength="6"
                  autocomplete="new-password"
                  required
                />
              </div>
              <div class="col-md-6 mb-3">
                <label class="form-label fw-bold small text-secondary">Konfirmasi</label>
                <input
                  name="repassword"
                  type="password"
                  class="form-control form-control-pill"
                  placeholder="Ulangi password"
                  minlength="6"
                  autocomplete="new-password"
                  required
                />
              </div>
            </div>

            <div class="mb-4">
              <label class="form-label fw-bold small text-secondary">Kode Referral <span class="text-muted">(opsional)</span></label>
              <input
                name="ref"
                type="text"
                class="form-control form-control-pill"
                placeholder="Masukkan kode jika ada"
                value="<%= typeof ref !== 'undefined' ? ref : '' %>"
              />
            </div>

            <button type="submit" class="btn btn-brand w-100 mb-4 py-3">
              <i class="fas fa-user-plus me-2"></i>Buat Akun Baru
            </button>

            <div class="text-center text-muted small">
              Sudah punya akun?
              <a href="/auth/login" class="text-decoration-none fw-bold text-success">Masuk di sini</a>
            </div>
          </form>
        </div>
      </div>
    </div>

    <div class="col-lg-6 d-none d-lg-flex auth-visual align-items-center">
      <div class="container px-5">
        <div class="mb-4">
          <div class="d-inline-flex align-items-center gap-2 bg-white bg-opacity-10 border border-light border-opacity-25 rounded-pill px-3 py-2 mb-4">
            <span class="indonesia-ribbon" aria-hidden="true"><span></span><span></span></span>
            <span class="fw-bold">Untuk bisnis lokal yang ingin lebih rapi</span>
          </div>
          <h1 class="display-5 fw-bold mb-3">Mulai dari satu nomor, scale ke banyak campaign.</h1>
          <p class="lead text-white-50">Cocok untuk toko online, sekolah, komunitas, reseller, dan aplikasi internal.</p>
        </div>
        <div class="benefit-card">
          <div class="benefit-row">
            <i class="fas fa-check-circle"></i>
            <div>
              <strong>Dashboard client lengkap</strong><br>
              <small class="text-white-50">Device, message, campaign, queue, inbox, dan reports.</small>
            </div>
          </div>
          <div class="benefit-row">
            <i class="fas fa-check-circle"></i>
            <div>
              <strong>API untuk developer</strong><br>
              <small class="text-white-50">Integrasi notifikasi order, OTP, reminder, dan webhook.</small>
            </div>
          </div>
          <div class="benefit-row">
            <i class="fas fa-check-circle"></i>
            <div>
              <strong>Alur lokal</strong><br>
              <small class="text-white-50">Nomor +62, kontak, opt-in, template, dan broadcast terjadwal.</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
