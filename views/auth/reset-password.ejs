<style>
  :root {
    --wa-brand: #25d366;
    --wa-hover: #1ebc57;
    --wa-dark: #075e54;
  }

  .auth-shell {
    min-height: 100vh;
    background: linear-gradient(135deg, #fbfffd, #eefdf4);
  }

  .auth-card {
    background: rgba(255, 255, 255, 0.94);
    border: 1px solid #dff1e9;
    border-radius: 8px;
    box-shadow: 0 18px 54px rgba(10, 84, 65, 0.12);
    padding: 32px;
  }

  .auth-brand {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--wa-dark);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .form-control-pill {
    border-radius: 8px;
    padding: 13px 15px;
    border: 1px solid #dfe6e3;
    background-color: #f8faf9;
  }

  .form-control-pill:focus {
    border-color: var(--wa-brand);
    box-shadow: 0 0 0 0.2rem rgba(37, 211, 102, 0.2);
    background-color: #fff;
  }

  .btn-brand {
    background-color: var(--wa-brand);
    color: white;
    border: none;
    border-radius: 8px;
    padding: 12px;
    font-weight: 700;
  }

  .btn-brand:hover {
    background-color: var(--wa-hover);
    color: white;
  }
</style>

<div class="container-fluid auth-shell d-flex align-items-center py-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-8 col-lg-5">
        <div class="text-center mb-4">
          <a href="/" class="auth-brand">
            <i class="fab fa-whatsapp text-success" style="font-size: 2rem"></i>
            <span>w@pi</span>
          </a>
        </div>
        <div class="auth-card">
          <h3 class="fw-bold mb-2">Buat password baru</h3>
          <p class="text-muted mb-4">
            <% if (reset) { %>
              Reset password untuk <strong><%= reset.email %></strong>.
            <% } else { %>
              Link reset password perlu valid sebelum password bisa diubah.
            <% } %>
          </p>

          <% if (message) { %>
            <div class="alert alert-success"><%= message %></div>
            <a href="/auth/login" class="btn btn-brand w-100 py-3">Login Sekarang</a>
          <% } else { %>
            <% if (error) { %>
              <div class="alert alert-danger"><%= error %></div>
            <% } %>

            <% if (reset) { %>
              <form action="/auth/reset-password" method="POST">
                <input type="hidden" name="token" value="<%= token %>" />
                <div class="mb-3">
                  <label class="form-label fw-bold small text-secondary">Password Baru</label>
                  <input
                    name="password"
                    type="password"
                    class="form-control form-control-pill"
                    placeholder="Minimal 6 karakter"
                    minlength="6"
                    autocomplete="new-password"
                    required
                  />
                </div>
                <div class="mb-4">
                  <label class="form-label fw-bold small text-secondary">Konfirmasi Password</label>
                  <input
                    name="repassword"
                    type="password"
                    class="form-control form-control-pill"
                    placeholder="Ulangi password baru"
                    minlength="6"
                    autocomplete="new-password"
                    required
                  />
                </div>
                <button type="submit" class="btn btn-brand w-100 py-3">
                  <i class="fa fa-key me-2"></i>Simpan Password Baru
                </button>
              </form>
            <% } %>

            <div class="text-center mt-4 small">
              <a href="/auth/forgot-password" class="text-decoration-none fw-bold text-success">Minta link baru</a>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
