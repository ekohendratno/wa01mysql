<style>
  :root {
    --wa-brand: #25d366;
    --wa-hover: #1ebc57;
    --wa-dark: #075e54;
    --id-red: #d91f2d;
    --auth-soft: #eefdf4;
  }

  .auth-shell {
    min-height: 100vh;
    background: linear-gradient(135deg, #fbfffd, #eefdf4);
  }

  .auth-form-side {
    min-height: 100vh;
    background: rgba(255, 255, 255, 0.92);
  }

  .auth-brand {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--wa-dark);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .auth-brand::after {
    content: "ID";
    font-size: 0.7rem;
    font-weight: 800;
    color: var(--id-red);
    border: 1px solid rgba(217, 31, 45, 0.25);
    border-radius: 999px;
    padding: 2px 7px;
  }

  .form-control-pill {
    border-radius: 8px;
    padding: 13px 15px;
    border: 1px solid #dfe6e3;
    background-color: #f8faf9;
  }

  .form-control-pill:focus {
    border-color: var(--wa-brand);
    box-shadow: 0 0 0 0.2rem rgba(37, 211, 102, 0.2);
    background-color: #fff;
  }

  .btn-brand {
    background-color: var(--wa-brand);
    color: white;
    border: none;
    border-radius: 8px;
    padding: 12px;
    font-weight: 700;
  }

  .btn-brand:hover {
    background-color: var(--wa-hover);
    color: white;
  }

  .auth-visual {
    min-height: 100vh;
    background:
      linear-gradient(135deg, rgba(249, 255, 252, 0.96), rgba(224, 250, 235, 0.92)),
      url("https://images.unsplash.com/photo-1556745757-8d76bdb6984b?auto=format&fit=crop&w=1400&q=80");
    background-size: cover;
    background-position: center;
    color: #0b221e;
    position: relative;
    overflow: hidden;
  }

  .indonesia-ribbon {
    display: inline-flex;
    width: 58px;
    height: 12px;
    border-radius: 999px;
    overflow: hidden;
    box-shadow: 0 0 0 1px rgba(7, 94, 84, 0.08);
  }

  .indonesia-ribbon span:first-child {
    background: #e11d2e;
    flex: 1;
  }

  .indonesia-ribbon span:last-child {
    background: #fff;
    flex: 1;
  }

  .auth-preview {
    background: rgba(255, 255, 255, 0.88);
    border: 1px solid #dff1e9;
    border-radius: 8px;
    padding: 18px;
    box-shadow: 0 18px 54px rgba(10, 84, 65, 0.12);
    backdrop-filter: blur(8px);
  }

  .auth-preview-row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid #e3f2eb;
  }

  .auth-visual .bg-white.bg-opacity-10 {
    background: rgba(255, 255, 255, 0.86) !important;
    border-color: #dff1e9 !important;
  }

  .auth-visual .text-white-50 {
    color: #5f756f !important;
  }

  .auth-preview-row:last-child {
    border-bottom: 0;
  }

  @media (max-width: 992px) {
    .auth-form-side {
      min-height: 100vh;
    }
  }
</style>

<div class="container-fluid p-0 auth-shell">
  <div class="row g-0">
    <div class="col-lg-6 auth-form-side d-flex flex-column">
      <div class="d-flex justify-content-between align-items-center p-3 p-md-4">
        <a href="/" class="auth-brand">
          <i class="fab fa-whatsapp text-success" style="font-size: 2rem"></i>
          <span>w@pi</span>
        </a>
        <div class="d-flex gap-2">
          <a href="/" class="btn btn-outline-secondary px-3" style="border-radius: 8px">
            <i class="fas fa-home me-md-2"></i><span class="d-none d-md-inline">Beranda</span>
          </a>
          <a href="/auth/register" class="btn btn-success px-3" style="border-radius: 8px; background: var(--wa-brand); border: 0">
            <i class="fas fa-user-plus me-md-2"></i><span class="d-none d-md-inline">Daftar</span>
          </a>
        </div>
      </div>

      <div class="row justify-content-center my-auto w-100 mx-0 px-4 px-md-5 py-4">
        <div class="col-md-8 col-lg-8">
          <div class="mb-4">
            <div class="d-inline-flex align-items-center gap-2 text-danger fw-bold small mb-3">
              <span class="indonesia-ribbon" aria-hidden="true"><span></span><span></span></span>
              Dashboard Indonesia
            </div>
            <h2 class="fw-bold text-dark mb-2">Masuk ke dashboard w@pi</h2>
            <p class="text-muted mb-0">Kelola device, campaign, queue, webhook, dan laporan WhatsApp bisnis Anda.</p>
          </div>

          <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
          <% } %>

          <form action="/auth/login" method="POST">
            <div class="mb-4">
              <label class="form-label fw-bold small text-secondary">Username / Email</label>
              <input
                name="username"
                type="text"
                class="form-control form-control-pill"
                placeholder="nama@email.com"
                autocomplete="username"
                required
              />
            </div>

            <div class="mb-4">
              <label class="form-label fw-bold small text-secondary">Password</label>
              <input
                name="password"
                type="password"
                class="form-control form-control-pill"
                placeholder="Masukkan password"
                autocomplete="current-password"
                required
              />
              <div class="text-end mt-2">
                <a href="/auth/forgot-password" class="small text-decoration-none text-success fw-bold">
                  Lupa sandi?
                </a>
              </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="remember" id="rememberMe" />
                <label class="form-check-label small text-muted" for="rememberMe">Ingat saya</label>
              </div>
              <a href="/auth/forgot-password" class="small text-decoration-none text-success fw-bold">Reset password</a>
            </div>

            <button type="submit" class="btn btn-brand w-100 mb-4 py-3">
              <i class="fas fa-right-to-bracket me-2"></i>Masuk
            </button>

            <div class="text-center text-muted small">
              Belum punya akun?
              <a href="/auth/register" class="text-decoration-none fw-bold text-success">Daftar gratis</a>
            </div>
          </form>
        </div>
      </div>
    </div>

    <div class="col-lg-6 d-none d-lg-flex auth-visual align-items-center">
      <div class="container px-5">
        <div class="mb-4">
          <div class="d-inline-flex align-items-center gap-2 bg-white bg-opacity-10 border border-light border-opacity-25 rounded-pill px-3 py-2 mb-4">
            <span class="indonesia-ribbon" aria-hidden="true"><span></span><span></span></span>
            <span class="fw-bold">Untuk UMKM, sekolah, komunitas, dan developer lokal</span>
          </div>
          <h1 class="display-5 fw-bold mb-3">Satu dashboard untuk WhatsApp bisnis Indonesia.</h1>
          <p class="lead text-white-50">Pantau nomor aktif, kirim campaign, cek pesan gagal, dan pastikan webhook berjalan.</p>
        </div>
        <div class="auth-preview">
          <div class="auth-preview-row">
            <div>
              <strong>Notifikasi order</strong><br>
              <small class="text-white-50">Invoice dan status pembayaran</small>
            </div>
            <span class="text-success">sent</span>
          </div>
          <div class="auth-preview-row">
            <div>
              <strong>Promo pelanggan</strong><br>
              <small class="text-white-50">Broadcast terjadwal</small>
            </div>
            <span class="text-warning">queued</span>
          </div>
          <div class="auth-preview-row">
            <div>
              <strong>Webhook toko online</strong><br>
              <small class="text-white-50">order.paid</small>
            </div>
            <span class="text-success">200 OK</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
